# ============================================================================
# EnTIQ — environment template.  Copy to .env.local (git-ignored) and fill in.
# Names are grouped by the module that consumes them. Values are never committed.
# ============================================================================

# ---- Platform spine ---------------------------------------------------------
ENV=development
DATABASE_URL=postgresql+psycopg://entiq:CHANGE_ME@localhost:5432/entiq
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=                       # 32+ chars; python -c "import secrets;print(secrets.token_hex(32))"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_PUBLIC_URL=http://localhost:5180
ALLOWED_ORIGINS=http://localhost:5180

# ---- Billing (Stripe) — base plan + module subscriptions ---------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASE_MONTHLY=        # $99 + GST base plan price id
GST_RATE_BPS=1000

# ---- Communications ---------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@entiq.com.au
SMTP_USE_TLS=true

# ---- Storage ----------------------------------------------------------------
STORAGE_BACKEND=local             # local | s3
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=                # leave empty on AWS — use an IAM role
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ---- AI ---------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Verify (KYC / AML) -----------------------------------------------------
DIDIT_API_KEY=
DIDIT_BASE_URL=
DIDIT_WEBHOOK_SECRET=
DIDIT_WORKFLOW_INDIVIDUAL=
DIDIT_WORKFLOW_KYB=
OPENSANCTIONS_API_KEY=
OPENSANCTIONS_BASE_URL=https://api.opensanctions.org
OPENSANCTIONS_DATASET=default
OPENSANCTIONS_THRESHOLD=0.7
EQUIFAX_SOAP_ENDPOINT=
EQUIFAX_COMPANY_ENDPOINT=
EQUIFAX_PREV_ENDPOINT=
EQUIFAX_SOAP_USERNAME=
EQUIFAX_SOAP_PASSWORD=
EQUIFAX_SUBSCRIBER_ID=
EQUIFAX_SECURITY_CODE=
ABR_API_GUID=

# ---- Workpapers (Xero) ------------------------------------------------------
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=

# ---- Frontend ---------------------------------------------------------------
VITE_API_PROXY_TARGET=http://localhost:8000
